# Estudio Lumen — variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA debe subirse al repositorio.

# Puerto del servidor Express.
# En local, 3000. En Render NO hace falta definirlo: la plataforma inyecta su
# propio PORT y el servidor lo respeta.
PORT=3000

# Confianza en el proxy inverso.
# Ponlo a 1 SOLO en Render (o detrás de cualquier proxy/CDN): sin esto,
# express-rate-limit ve la IP del proxy en todas las peticiones y trata a todos
# los visitantes como si fueran uno solo.
# En desarrollo local déjalo ausente o vacío: activarlo sin un proxy real
# delante permitiría falsificar la IP con una cabecera X-Forwarded-For a mano.
TRUST_PROXY=

# SMTP — notificaciones internas de los formularios (Mailtrap sandbox en desarrollo)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASS=tu_password_mailtrap

# Remitente y destinatario de las notificaciones internas
MAIL_FROM=Estudio Lumen <no-reply@estudiolumen.example>
ADMIN_NOTIFY_EMAIL=estudio@estudiolumen.example

# SQLite — ruta del archivo de base de datos (se crea en el primer arranque).
# Ruta relativa a la raíz del proyecto; el directorio se crea solo si no existe.
DB_PATH=./data/lumen.sqlite
