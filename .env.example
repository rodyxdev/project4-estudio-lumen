# Estudio Lumen — variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA debe subirse al repositorio.

# Puerto del servidor Express en desarrollo local.
# En Vercel no aplica: allí la app corre como función serverless (api/index.js).
PORT=3000

# Confianza en el proxy inverso.
# Ponlo a 1 SOLO detrás de un proxy (Vercel): sin esto, el rate limiting ve la
# IP del edge en todas las peticiones y trata a todos los visitantes como uno
# solo. En desarrollo local déjalo ausente o vacío: activarlo sin un proxy real
# delante permitiría falsificar la IP con una cabecera X-Forwarded-For a mano.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# URL del proyecto, del estilo https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# SERVICE ROLE KEY — no la anon key.
# Salta cualquier política RLS y tiene acceso total al proyecto, así que es
# código de servidor y nada más:
#   · NUNCA la expongas al cliente (nada de public/ ni de variables NEXT_PUBLIC_*)
#   · NUNCA la imprimas en un log ni en un mensaje de error
#   · NUNCA la commitees: va en .env local y en las env vars de Vercel
# Se obtiene en Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ---------------------------------------------------------------------------
# SMTP — notificaciones internas de los formularios (Mailtrap sandbox en dev)
# ---------------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_mailtrap
SMTP_PASS=tu_password_mailtrap

# Remitente y destinatario de las notificaciones internas
MAIL_FROM=Estudio Lumen <no-reply@estudiolumen.example>
ADMIN_NOTIFY_EMAIL=estudio@estudiolumen.example
